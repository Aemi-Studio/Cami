    "perms.calendars.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cami ONLY uses your on-device calendar information to display events in widgets.\n\nCami DOES NOT edit, delete, save or send those information away."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cami utilise UNIQUEMENT les informations de calendrier de votre appareil pour afficher les événements dans les widgets.\n\nCami NE modifie PAS, ne supprime pas, n'enregistre pas et n'envoie pas ces informations."
          }
        }
      }
    },
