    "knowledgebase.item.outdatedWidgetContent.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cami relies completely on iOS features and mechanisms. According to documentation provided by Apple, a widget can be updated every five minutes at most. If you want to force the update of your actual widgets, you just have to open the app and close it right after. This automatically refreshes widgets. If it does not work, you can try long pressing the \"Everything is fine.\" green box on the welcome screen of Cami and then tap on \"Refresh widgets\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cami repose entièrement sur les fonctionnalités et mécanismes d'iOS. Selon la documentation fournie par Apple, un widget peut être mis à jour toutes les cinq minutes au maximum. Si vous souhaitez forcer la mise à jour de vos widgets, il vous suffit d'ouvrir l'application et de la fermer juste après. Cela actualise automatiquement les widgets. Si cela ne fonctionne pas, vous pouvez essayer d'appuyer longuement sur le cadre vert « Tout va bien » sur l'écran d'accueil de Cami, puis appuyer sur « Actualiser les widgets »."
          }
        }
      }
    },
    "knowledgebase.item.outdatedWidgetContent.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why does my widget content seem outdated?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi le contenu de mon widget semble-t-il obsolète ?"
          }
        }
      }
    },
    "knowledgebase.item.requestAccessToContacts.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cami presents by default the next birthday from your contacts in the top right corner of the widget, therefore Cami needs to access your contacts. If you disable contact access, next birthday won't be displayed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cami affiche par défaut le prochain anniversaire de vos contacts dans le coin supérieur droit du widget, c'est pourquoi Cami a besoin d'accéder à vos contacts. Si vous désactivez l'accès aux contacts, le prochain anniversaire ne sera pas affiché."
          }
        }
      }
    },
    "knowledgebase.item.requestAccessToContacts.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why does Cami request access to Contacts?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi Cami demande-t-il l'accès aux Contacts ?"
          }
        }
      }
    },
    "knowledgebase.item.requestAccessToReminders.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cami blends your reminders and the events from your calendars in a streamlined interface in the widget and the app to increase and improve the quantity of information provided."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cami combine vos rappels et les événements de vos calendriers dans une interface épurée dans le widget et l'application pour augmenter et améliorer la quantité d'informations fournies."
          }
        }
      }
    },
    "knowledgebase.item.requestAccessToReminders.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why does Cami request access to your Reminders?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi Cami demande-t-il l'accès à vos Rappels ?"
          }
        }
      }
    },
    "knowledgebase.item.requestFullAccessToCalendar.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS requires applications to either request access to calendars in order to be able to edit events OR read and edit events. We need to read every events from every calendars, hence the request for \"Full Access\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS exige que les applications demandent l'accès aux calendriers soit pour pouvoir modifier les événements, soit pour lire et modifier les événements. Nous devons lire tous les événements de tous les calendriers, d'où la demande d'« Accès complet »."
          }
        }
      }
    },
    "knowledgebase.item.requestFullAccessToCalendar.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why does Cami request full access to Calendars?"
          }
        },
